{
  "name": "sportybet-api",
  "version": "1.0.0",
  "private": true,
  "description": "Turn SportyBet into an auto-updating OpenAPI. A generator probes the live site and infers JSON Schemas; a server serves the spec and proxies the endpoints.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "capture:ilotbet": "node tools/capture.mjs",
    "generate": "node src/generate.mjs",
    "login": "node src/login.mjs",
    "probe:ilotbet": "node tools/probe-api.mjs",
    "serve": "node src/server.mjs",
    "smoke": "node test/smoke.mjs",
    "start": "node src/server.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "ui:ilotbet": "node src/ilotbet/ui.mjs"
  },
  "optionalDependencies": {
    "playwright-core": "^1.40.0"
  }
}
